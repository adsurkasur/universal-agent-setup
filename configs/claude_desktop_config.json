{
  "mcpServers": {
    "drawio": {
      "command": "npx",
      "args": [
        "-y",
        "@drawio/mcp"
      ],
      "disabled": false
    },
    "ripple": {
      "command": "npx",
      "args": [
        "-y",
        "@ytsuda/ripple@latest"
      ]
    },
    "android-emulator": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-android-emulator"
      ],
      "disabled": false,
      "env": {
        "ADB_PATH": "__ANDROID_ADB_PATH__",
        "ANDROID_HOME": "__ANDROID_HOME__",
        "ANDROID_SDK_ROOT": "__ANDROID_HOME__"
      }
    },
    "arduino": {
      "command": "npx",
      "args": [
        "-y",
        "arduino-mcp-server"
      ],
      "disabled": false,
      "env": {
        "ARDUINO_CLI_PATH": "__ARDUINO_CLI_PATH__"
      }
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "better-icons": {
      "command": "npx",
      "args": [
        "-y",
        "better-icons"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath",
        "__BROWSER_PATH__"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "__GITHUB_PERSONAL_ACCESS_TOKEN__"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "rea": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "npx",
        "-y",
        "rea-agents@6.7.0",
        "mcp"
      ]
    },
    "play-console": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "npx",
        "-y",
        "@orellbuehler/play-console-mcp@0.3.1"
      ],
      "env": {
        "GOOGLE_SERVICE_ACCOUNT_KEY_PATH": "__GOOGLE_PLAY_KEY_PATH__"
      }
    }
  },
  "preferences": {
    "coworkBrowserToolsEnabled": true,
    "coworkPreferredBrowser": "built_in",
    "coworkScheduledTasksEnabled": true,
    "coworkWebSearchEnabled": true,
    "chicagoEnabled": true
  }
}
